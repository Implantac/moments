# ============================================================================
# Moments Paris — variáveis de ambiente
# Copie para .env.local (desenvolvimento) ou configure na Vercel (produção).
# ============================================================================

# --- Obrigatória -------------------------------------------------------------
# PostgreSQL. Em produção use a connection string *pooled* (Neon/Supabase).
# NUNCA use localhost/127.0.0.1 na Vercel.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/moments

# --- PIX (recebimento direto, sem gateway) -----------------------------------
# Chave do recebedor: CPF/CNPJ (só dígitos), e-mail, telefone ou aleatória.
# O QR Code é gerado no servidor com o valor exato do pedido.
PIX_KEY=000.000.000-00            # chave do recebedor (vai no QR Code)
PIX_HOLDER=Nome do recebedor
PIX_CITY=LONDRINA

# --- Segurança ---------------------------------------------------------------
# Assina o link do pedido (protege nome/endereço) e o cookie do admin.
# Gere um valor aleatório: openssl rand -base64 32
ORDER_SECRET=
# Senha da área /admin (mínimo 8 caracteres). Sem ela, o admin fica bloqueado.
ADMIN_PASSWORD=

# --- Notificações (opcionais, mas recomendadas) ------------------------------
# Telegram: crie um bot com @BotFather e pegue o chat_id com @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# E-mail transacional via Resend (3.000/mês grátis).
RESEND_API_KEY=
RESEND_FROM="Moments Paris <pedidos@seudominio.com.br>"
STORE_EMAIL=pedidos@seudominio.com.br
# Enviar também cópia para o cliente? (true/false)
NOTIFY_CUSTOMER=false

# --- Site --------------------------------------------------------------------
# Domínio canônico. Use na Vercel para sitemap, OG e links absolutos.
NEXT_PUBLIC_SITE_URL=https://www.seudominio.com.br
# Dados exibidos no rodapé e nas páginas legais (obrigatórios no CDC).
NEXT_PUBLIC_CNPJ=
NEXT_PUBLIC_STORE_EMAIL=
NEXT_PUBLIC_WHATSAPP=5543999542246
